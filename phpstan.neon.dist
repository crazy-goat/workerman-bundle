includes:
	- vendor/tomasvotruba/cognitive-complexity/config/extension.neon

parameters:
	level: 8
	cognitive_complexity:
		function: 30
		class: 150
	treatPhpDocTypesAsCertain: false
	bootstrapFiles:
		- tools/php-cs-fixer/autoload.php
	scanFiles:
		- phpstan-stubs/inotify.stub
	paths:
		- src
		- tests
		- benchmarks
		- bin
		- tools
	ignoreErrors:
		-
			message: '#never returns string so it can be removed from the return type#'
			paths:
				- tests/
				- benchmarks/
			reportUnmatched: false
		-
			message: '#Call to method.*on a separate line has no effect#'
			path: benchmarks/
			reportUnmatched: false